# Copy this file to .env and fill in the values. .env is excluded from Git and Docker images.

# MongoDB Atlas connection string: Atlas > your cluster > Connect > Drivers > Node.js.
# Replace <db_user> and <db_password>; URL-encode special characters in the password (@ becomes %40, and so on).
MONGODB_URI=mongodb+srv://slsea:SlseaPass2026@cluster0.5gvm9b4.mongodb.net/?appName=Cluster0
MONGODB_DB=slsea_solar

# HTTP port (default 8787).
PORT=8787

# Application secrets. Run "npm run secrets" to generate random values.
JWT_SECRET=replace-with-random-secret
DEVICE_MASTER=replace-with-a-different-random-secret
USER_PASSWORD=replace-with-a-strong-password

# Optional: public origin when running behind a proxy or on a hosting platform,
# so pagination Link and Location headers use the public address.
# PUBLIC_BASE_URL=https://your-api.example.com

# Optional: set to true to skip index/validator creation at start-up (for a restricted database user, see README).
# SKIP_SCHEMA_SETUP=false
