{
  "name": "slsea-generation-api",
  "version": "1.0.0",
  "private": true,
  "description": "SLSEA Solar Generation API on Node.js and MongoDB Atlas",
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.mjs",
    "secrets": "node scripts/generate-secrets.mjs",
    "openapi": "node scripts/generate-openapi.mjs",
    "test": "node tests/api.test.mjs",
    "test:atlas": "node --env-file=.env tests/api.test.mjs --atlas",
    "verify:live": "node --env-file-if-exists=.env scripts/verify-live.mjs"
  },
  "dependencies": {
    "mongodb": "^6.10.0"
  }
}
